      "glossary": {
        "title": "📚 Glossaire des Termes du Casino en Ligne",
        "intro": "Maîtrisez le vocabulaire essentiel pour jouer comme un pro !",
        "rtp": {
          "term": "RTP (Return to Player)",
          "definition": "% théorique reversé aux joueurs sur le long terme. Ex: RTP 96% = 96€ reversés pour 100€ misés (en moyenne)."
        },
        "variance": {
          "term": "Variance (ou Volatilité)",
          "definition": "Fréquence et taille des gains. Haute variance = gains rares mais gros. Basse variance = gains fréquents mais petits."
        },
        "wager": {
          "term": "Wager (Exigence de mise)",
          "definition": "Montant à miser avant de retirer un bonus. Wager x30 sur 100€ = miser 3000€ avant retrait."
        },
        "houseEdge": {
          "term": "House Edge (Avantage Maison)",
          "definition": "Avantage mathématique du casino. Plus il est bas, mieux c'est pour le joueur. Ex: Blackjack = 0.5%, Roulette US = 5.26%."
        },
        "bankroll": {
          "term": "Bankroll",
          "definition": "Budget total alloué au jeu. Règle d'or : ne misez jamais plus de 1-2% de votre bankroll par tour."
        },
        "rng": {
          "term": "RNG (Random Number Generator)",
          "definition": "Générateur de nombres aléatoires garantissant l'équité des résultats en ligne."
        },
        "hit": {
          "term": "Hit (Blackjack)",
          "definition": "Demander une carte supplémentaire au croupier."
        },
        "stand": {
          "term": "Stand (Blackjack)",
          "definition": "Garder sa main actuelle sans prendre de carte supplémentaire."
        },
        "split": {
          "term": "Split (Blackjack)",
          "definition": "Séparer deux cartes identiques en deux mains distinctes (nécessite une mise supplémentaire)."
        },
        "doubleDown": {
          "term": "Double Down (Blackjack)",
          "definition": "Doubler sa mise en échange d'une seule carte supplémentaire."
        },
        "freeSpins": {
          "term": "Free Spins (Tours Gratuits)",
          "definition": "Tours de slots offerts par le casino, souvent avec des conditions de wager."
        },
        "cashback": {
          "term": "Cashback",
          "definition": "Remboursement d'un % de vos pertes sur une période donnée. Ex: 10% cashback sur pertes hebdomadaires."
        }
      },
